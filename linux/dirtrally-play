#!/bin/sh
# Plays DiRT Rally (Feral's native Linux port) through gamescope, using the
# rea-launcher-sdk play library (sdk/rea-play.sh; see its shell/README.md).
#
#   dirtrally-play             show the settings window, then start the game
#   dirtrally-play --play      start with the saved settings (no window)
#   dirtrally-play stop        end the game session
#   dirtrally-play status      running or idle
#   dirtrally-play <other>     passed to DiRTRallyLauncher (--check, --help, ...)
#
# Every launch waits for the game to end. The game runs in its own session,
# recorded with its start time, so "stop" ends exactly that session
# (gamescope, the launcher, the game).
#
# Optional environment:
#   DIRTRALLY_LAUNCHER   the DiRTRallyLauncher program (default: next to this
#                        script, one up, or a development build)
#   DIRTRALLY_GAME_LIBS  the launcher's game-libs folder (development builds)
#   DIRTRALLY_RUN        a wrapper that runs gamescope and the game, e.g.
#                        "distrobox enter gaming --" when gamescope lives in a
#                        container (HOME and the XDG folders are kept); paths
#                        with spaces are not supported here
#   DIRTRALLY_WAIT       accepted for AppImage compatibility; every launch waits
#   DIRTRALLY_GPU        GPU environment to use instead of the detected one
#   DIRTRALLY_SCREEN     WIDTHxHEIGHT for gamescope (default: the current mode
#                        from xrandr, else 1920x1080)
set -u

# --- the library: next to this script in a package, else the vendored copy --
# Tests source this script with REA_FUNCTIONS_ONLY=1 (load, don't run) and
# REA_PLAY_HERE=<this script's folder> ($0 is then the test). REA_PLAY_HERE
# counts only in that mode; the library drops both once sourced.
_fonly=${REA_FUNCTIONS_ONLY:-}
_here=$(dirname "$(readlink -f "$0")")
[ "$_fonly" = 1 ] && [ -n "${REA_PLAY_HERE:-}" ] && _here=$REA_PLAY_HERE
if [ -f "$_here/rea-play.sh" ]; then
  . "$_here/rea-play.sh"
elif [ -f "$_here/../sdk/rea-play.sh" ]; then
  . "$_here/../sdk/rea-play.sh"
else
  echo "rea-play.sh not found next to $0 or in ../sdk (run scripts/sdk-sync)" >&2
  exit 1
fi
REA_HERE=$_here REA_NAME=dirtrally-play

# --- configuration (after sourcing: inherited REA_* values are dropped, so
# only the player-facing DIRTRALLY_* names below reach the library) ----------
REA_MODE=native
REA_APP=dirtrally-launcher                 # ~/.config/dirtrally-launcher
REA_EXE_NAME=DiRTRallyLauncher
REA_EXE_HINT=DIRTRALLY_LAUNCHER
REA_EXE=${DIRTRALLY_LAUNCHER:-}
REA_EXE_SEARCH="../target/release/DiRTRallyLauncher ../target/debug/DiRTRallyLauncher"
REA_STATE_BASE=${XDG_CONFIG_HOME:-$HOME/.config}
REA_WAIT=${DIRTRALLY_WAIT:-}
# A wrapper for gamescope and the game, e.g. "distrobox enter gaming --" when
# gamescope lives in a container. A container has a HOME of its own, so the
# player's folders go with it: launcher.cfg, the private copy and the game's
# saves stay where they are without the wrapper.
REA_RUN=${DIRTRALLY_RUN:-}
if [ -n "$REA_RUN" ]; then
  _cfg=${XDG_CONFIG_HOME:-$HOME/.config} _data=${XDG_DATA_HOME:-$HOME/.local/share}
  # REA_RUN is split into words, so these folders cannot hold spaces or
  # wildcards there.
  for _p in "$HOME" "$_cfg" "$_data"; do
    case $_p in
      *[[:space:]]* | *[\*?[]*)
        echo "dirtrally-play: DIRTRALLY_RUN cannot be used while '$_p' has spaces or wildcards in its name; install gamescope next to the launcher instead." >&2
        exit 1 ;;
    esac
  done
  REA_RUN="$REA_RUN env HOME=$HOME XDG_CONFIG_HOME=$_cfg XDG_DATA_HOME=$_data"
fi
[ -n "${DIRTRALLY_GPU+set}" ] && REA_GPU=$DIRTRALLY_GPU   # DIRTRALLY_GPU= for no GPU choice
# gamescope: the game runs fullscreen at the screen's size.
REA_FULLSCREEN_SIZE=screen
REA_SCREEN=${DIRTRALLY_SCREEN:-}
# The size each look gives gamescope when no resolution is set, as the
# launcher resolves it (this run's --resolution, its --look, the file's
# resolution, its look): Original is Feral's own window at the screen's
# size (rea_hook_before_start), Recommended the screen, Steam Deck its
# panel. `--play --resolution WxH` / `--look NAME` size that run.
REA_LOOK_SIZES="original=original recommended=screen steam_deck=1280x800"
REA_FLAG_SWITCHES="--no-window --settings --linux --check --help"
# The game run says it was started by this helper: a player is watching,
# so a refusal (no game, an unknown build) shows its window inside
# gamescope instead of only reaching the log.
REA_PLAY_ARGS="--no-window --linux"

# Original: Feral's own window chooses the size, so gamescope is the
# screen, as the game saw it when it shipped (not the 1920x1080 default).
rea_hook_before_start() {
  REA_ORIGINAL_SIZE=$(rea_screen_size) || REA_ORIGINAL_SIZE=
}

rea_hook_command() {
  case "${1:-}" in
    '' | --play | play | start | status | stop | --settings | --help | -h) return 127 ;;   # the helper's own
    --check)
      # Checks the game folder; nothing starts, so no gamescope or session.
      rea_require_exe || exit 1
      # shellcheck disable=SC2086 # REA_RUN is split into words on purpose
      exec $REA_RUN "$REA_EXE" "$@" ;;
    *) return 127 ;;
  esac
}

rea_init || exit 1
# Tests load the configuration and hooks without running anything.
[ "$_fonly" = 1 ] && return 0
rea_main "$@"
